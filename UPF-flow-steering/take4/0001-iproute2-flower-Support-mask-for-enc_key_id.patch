From d7129a50003233a17f2dbc35e20f9fb51cba1032 Mon Sep 17 00:00:00 2001
From: Alexandre Cassen <acassen@corp.free.fr>
Date: Wed, 25 Mar 2026 11:04:14 +0100
Subject: [PATCH 1/2] flower: Support mask for enc_key_id

Allow specifying a mask for the enc_key_id flower key, e.g.:
  enc_key_id 1234/0xe0000000

Signed-off-by: Alexandre Cassen <acassen@corp.free.fr>
---
 include/uapi/linux/pkt_cls.h |  2 ++
 tc/f_flower.c                | 26 ++++++++++++++++++++------
 2 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/include/uapi/linux/pkt_cls.h b/include/uapi/linux/pkt_cls.h
index 3c24e8e2..16c3f96f 100644
--- a/include/uapi/linux/pkt_cls.h
+++ b/include/uapi/linux/pkt_cls.h
@@ -560,6 +560,8 @@ enum {
 	TCA_FLOWER_KEY_ENC_FLAGS,	/* be32 */
 	TCA_FLOWER_KEY_ENC_FLAGS_MASK,	/* be32 */
 
+	TCA_FLOWER_KEY_ENC_KEY_ID_MASK,	/* be32 */
+
 	__TCA_FLOWER_MAX,
 };
 
diff --git a/tc/f_flower.c b/tc/f_flower.c
index 6fc2c6a1..55b6da8d 100644
--- a/tc/f_flower.c
+++ b/tc/f_flower.c
@@ -927,14 +927,28 @@ err:
 
 static int flower_parse_key_id(const char *str, int type, struct nlmsghdr *n)
 {
-	int ret;
-	__be32 key_id;
+	__be32 key_id, mask;
+	char *slash;
 
-	ret = get_be32(&key_id, str, 10);
-	if (!ret)
-		addattr32(n, MAX_MSG, type, key_id);
+	slash = strchr(str, '/');
+	if (slash)
+		*slash = '\0';
 
-	return ret;
+	if (get_be32(&key_id, str, 0)) {
+		if (slash)
+			*slash = '/';
+		return -1;
+	}
+	addattr32(n, MAX_MSG, type, key_id);
+
+	if (slash) {
+		*slash = '/';
+		if (get_be32(&mask, slash + 1, 0))
+			return -1;
+		addattr32(n, MAX_MSG, TCA_FLOWER_KEY_ENC_KEY_ID_MASK, mask);
+	}
+
+	return 0;
 }
 
 static int flower_parse_enc_port(char *str, int type, struct nlmsghdr *n)
-- 
