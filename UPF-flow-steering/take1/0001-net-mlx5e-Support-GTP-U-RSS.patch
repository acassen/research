From beb2abbc2d0d3f85d5d0e75558c8a43c36657b46 Mon Sep 17 00:00:00 2001
From: Alexandre Cassen <acassen@corp.free.fr>
Date: Wed, 25 Mar 2026 08:49:25 +0100
Subject: [PATCH] net/mlx5e: Support GTP-U RSS

Extend the mlx5 TTC and RSS subsystems to support GTP-U (UDP port 2152)
traffic steering and hashing.

Adding two new traffic types (MLX5_TT_IPV4_GTPU / MLX5_TT_IPV6_GTPU), wire
a new MLX5_HASH_FIELD_SEL_GTPU_TEID hash field selector and expose
GTPU_V4/V6_FLOW through ethtool rxfh.

Created 4 new TTC group variants covering all (l4_type x ipsec_rss x gtpu_rss)
combinaisons and updated mlx5_ttc_get_fs_groups() and
mlx5_ttc_has_esp_flow_group() accordingly.

Signed-off-by: Alexandre Cassen <acassen@corp.free.fr>
---
 .../net/ethernet/mellanox/mlx5/core/en/fs.h   |   3 +
 .../net/ethernet/mellanox/mlx5/core/en/rss.c  |  10 ++
 .../net/ethernet/mellanox/mlx5/core/en_fs.c   |  14 ++
 .../mellanox/mlx5/core/en_fs_ethtool.c        |  28 ++-
 .../ethernet/mellanox/mlx5/core/lib/fs_ttc.c  | 159 +++++++++++++++++-
 .../ethernet/mellanox/mlx5/core/lib/fs_ttc.h  |   8 +
 include/linux/mlx5/device.h                   |   1 +
 7 files changed, 206 insertions(+), 17 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en/fs.h b/drivers/net/ethernet/mellanox/mlx5/core/en/fs.h
index c3408b3f7010..db6e4f8e61ff 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en/fs.h
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en/fs.h
@@ -68,6 +68,9 @@ struct mlx5e_l2_table {
 #define MLX5_HASH_IP_IPSEC_SPI	(MLX5_HASH_FIELD_SEL_SRC_IP   |\
 				 MLX5_HASH_FIELD_SEL_DST_IP   |\
 				 MLX5_HASH_FIELD_SEL_IPSEC_SPI)
+#define MLX5_HASH_IP_GTPU_TEID	(MLX5_HASH_FIELD_SEL_SRC_IP   |\
+				 MLX5_HASH_FIELD_SEL_DST_IP   |\
+				 MLX5_HASH_FIELD_SEL_GTPU_TEID)
 
 /* NIC promisc FT level */
 enum {
diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en/rss.c b/drivers/net/ethernet/mellanox/mlx5/core/en/rss.c
index a2ec67a122d9..fc70270b82cc 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en/rss.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en/rss.c
@@ -49,6 +49,16 @@ static const struct mlx5e_rss_params_traffic_type rss_default_config[MLX5E_NUM_I
 		.l4_prot_type = 0,
 		.rx_hash_fields = MLX5_HASH_IP_IPSEC_SPI,
 	},
+	[MLX5_TT_IPV4_GTPU] = {
+		.l3_prot_type = MLX5_L3_PROT_TYPE_IPV4,
+		.l4_prot_type = MLX5_L4_PROT_TYPE_UDP,
+		.rx_hash_fields = MLX5_HASH_IP_GTPU_TEID,
+	},
+	[MLX5_TT_IPV6_GTPU] = {
+		.l3_prot_type = MLX5_L3_PROT_TYPE_IPV6,
+		.l4_prot_type = MLX5_L4_PROT_TYPE_UDP,
+		.rx_hash_fields = MLX5_HASH_IP_GTPU_TEID,
+	},
 	[MLX5_TT_IPV4] = {
 		.l3_prot_type = MLX5_L3_PROT_TYPE_IPV4,
 		.l4_prot_type = 0,
diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c b/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c
index 9352e2183312..0c55dc3a7844 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c
@@ -924,6 +924,18 @@ static bool mlx5e_ipsec_rss_supported(struct mlx5_core_dev *mdev)
 	       MLX5_CAP_NIC_RX_FT_FIELD_SUPPORT_2(mdev, inner_l4_type_ext);
 }
 
+static bool mlx5e_gtpu_rss_supported(struct mlx5_core_dev *mdev)
+{
+	if (!MLX5_CAP_FLOWTABLE_NIC_RX(mdev, ft_field_support.gtpu_teid))
+		return false;
+
+	if (!(MLX5_CAP_GEN(mdev, flex_parser_protocols) &
+	     MLX5_FLEX_PARSER_GTPU_ENABLED))
+		return false;
+
+	return true;
+}
+
 void mlx5e_set_ttc_params(struct mlx5e_flow_steering *fs,
 			  struct mlx5e_rx_res *rx_res,
 			  struct ttc_params *ttc_params, bool tunnel,
@@ -941,6 +953,8 @@ void mlx5e_set_ttc_params(struct mlx5e_flow_steering *fs,
 	ttc_params->ipsec_rss = ipsec_rss &&
 				mlx5e_ipsec_rss_supported(fs->mdev);
 
+	ttc_params->gtpu_rss  = mlx5e_gtpu_rss_supported(fs->mdev);
+
 	for (tt = 0; tt < MLX5_NUM_TT; tt++) {
 		if (mlx5_ttc_is_decrypted_esp_tt(tt))
 			continue;
diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c b/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c
index aecfba7deeb0..4ee35c827f83 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c
@@ -883,6 +883,10 @@ static int flow_type_to_traffic_type(u32 flow_type)
 		return MLX5_TT_IPV4_IPSEC_ESP;
 	case ESP_V6_FLOW:
 		return MLX5_TT_IPV6_IPSEC_ESP;
+	case GTPU_V4_FLOW:
+		return MLX5_TT_IPV4_GTPU;
+	case GTPU_V6_FLOW:
+		return MLX5_TT_IPV6_GTPU;
 	case IPV4_FLOW:
 	case IP_USER_FLOW:
 		return MLX5_TT_IPV4;
@@ -915,15 +919,19 @@ int mlx5e_ethtool_set_rxfh_fields(struct mlx5e_priv *priv,
 	 *  on src IP, dest IP, TCP/UDP src port and TCP/UDP dest
 	 *  port.
 	 */
-	if (flow_type != TCP_V4_FLOW &&
-	    flow_type != TCP_V6_FLOW &&
-	    flow_type != UDP_V4_FLOW &&
-	    flow_type != UDP_V6_FLOW)
-		return -EOPNOTSUPP;
-
-	if (nfc->data & ~(RXH_IP_SRC | RXH_IP_DST |
-			  RXH_L4_B_0_1 | RXH_L4_B_2_3))
+	if (flow_type == GTPU_V4_FLOW || flow_type == GTPU_V6_FLOW) {
+		if (nfc->data & ~(RXH_IP_SRC | RXH_IP_DST | RXH_GTP_TEID))
+			return -EOPNOTSUPP;
+	} else if (flow_type == TCP_V4_FLOW ||
+		   flow_type == TCP_V6_FLOW ||
+		   flow_type == UDP_V4_FLOW ||
+		   flow_type == UDP_V6_FLOW) {
+		if (nfc->data & ~(RXH_IP_SRC | RXH_IP_DST |
+				  RXH_L4_B_0_1 | RXH_L4_B_2_3))
+			return -EOPNOTSUPP;
+	} else {
 		return -EOPNOTSUPP;
+	}
 
 	if (nfc->data & RXH_IP_SRC)
 		rx_hash_field |= MLX5_HASH_FIELD_SEL_SRC_IP;
@@ -933,6 +941,8 @@ int mlx5e_ethtool_set_rxfh_fields(struct mlx5e_priv *priv,
 		rx_hash_field |= MLX5_HASH_FIELD_SEL_L4_SPORT;
 	if (nfc->data & RXH_L4_B_2_3)
 		rx_hash_field |= MLX5_HASH_FIELD_SEL_L4_DPORT;
+	if (nfc->data & RXH_GTP_TEID)
+		rx_hash_field |= MLX5_HASH_FIELD_SEL_GTPU_TEID;
 
 	mutex_lock(&priv->state_lock);
 	err = mlx5e_rx_res_rss_set_hash_fields(priv->rx_res, rss_idx, tt, rx_hash_field);
@@ -970,6 +980,8 @@ int mlx5e_ethtool_get_rxfh_fields(struct mlx5e_priv *priv,
 		nfc->data |= RXH_L4_B_0_1;
 	if (hash_field & MLX5_HASH_FIELD_SEL_L4_DPORT)
 		nfc->data |= RXH_L4_B_2_3;
+	if (hash_field & MLX5_HASH_FIELD_SEL_GTPU_TEID)
+		nfc->data |= RXH_GTP_TEID;
 
 	return 0;
 }
diff --git a/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.c b/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.c
index 14c339d02e99..ea5904ad420c 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.c
@@ -5,15 +5,18 @@
 #include <linux/ipv6.h>
 #include <linux/tcp.h>
 #include <linux/mlx5/fs.h>
+#include <net/gtp.h>
 #include <linux/mlx5/driver.h>
 #include "mlx5_core.h"
 #include "lib/fs_ttc.h"
 
-#define MLX5_TTC_MAX_NUM_GROUPS		7
+#define MLX5_TTC_MAX_NUM_GROUPS		8
 #define MLX5_TTC_GROUP_TCPUDP_SIZE	(MLX5_TT_IPV6_UDP + 1)
+#define MLX5_TTC_GTPU_GROUP_SIZE	(MLX5_TT_IPV6_GTPU - MLX5_TT_IPV4_GTPU + 1)
 
 struct mlx5_fs_ttc_groups {
 	bool use_l4_type;
+	bool gtpu_group;
 	int num_groups;
 	int group_size[MLX5_TTC_MAX_NUM_GROUPS];
 };
@@ -74,6 +77,8 @@ static const char *mlx5_traffic_types_names[MLX5_NUM_TT] = {
 	[MLX5_TT_IPV6_IPSEC_AH] = "TT_IPV6_IPSEC_AH",
 	[MLX5_TT_IPV4_IPSEC_ESP] = "TT_IPV4_IPSEC_ESP",
 	[MLX5_TT_IPV6_IPSEC_ESP] = "TT_IPV6_IPSEC_ESP",
+	[MLX5_TT_IPV4_GTPU] = "TT_IPV4_GTPU",
+	[MLX5_TT_IPV6_GTPU] = "TT_IPV6_GTPU",
 	[MLX5_TT_IPV4] = "TT_IPV4",
 	[MLX5_TT_IPV6] = "TT_IPV6",
 	[MLX5_TT_ANY] = "TT_ANY"
@@ -122,6 +127,15 @@ static struct mlx5_etype_proto ttc_rules[] = {
 		.etype = ETH_P_IPV6,
 		.proto = IPPROTO_ESP,
 	},
+	/* GTP-U rules use udp_dport matching; etype only used here */
+	[MLX5_TT_IPV4_GTPU] = {
+		.etype = ETH_P_IP,
+		.proto = IPPROTO_UDP,
+	},
+	[MLX5_TT_IPV6_GTPU] = {
+		.etype = ETH_P_IPV6,
+		.proto = IPPROTO_UDP,
+	},
 	[MLX5_TT_IPV4] = {
 		.etype = ETH_P_IP,
 		.proto = 0,
@@ -169,6 +183,10 @@ enum TTC_GROUP_TYPE {
 	TTC_GROUPS_USE_L4_TYPE = 1,
 	TTC_GROUPS_DEFAULT_ESP = 2,
 	TTC_GROUPS_USE_L4_TYPE_ESP = 3,
+	TTC_GROUPS_GTPU = 4,
+	TTC_GROUPS_USE_L4_TYPE_GTPU = 5,
+	TTC_GROUPS_DEFAULT_ESP_GTPU = 6,
+	TTC_GROUPS_USE_L4_TYPE_ESP_GTPU = 7,
 };
 
 static const struct mlx5_fs_ttc_groups ttc_groups[] = {
@@ -215,6 +233,56 @@ static const struct mlx5_fs_ttc_groups ttc_groups[] = {
 			BIT(0),
 		},
 	},
+	[TTC_GROUPS_GTPU] = {
+		.gtpu_group = true,
+		.num_groups = 4,
+		.group_size = {
+			MLX5_TTC_GTPU_GROUP_SIZE,    /* GTP-U */
+			BIT(3) + MLX5_NUM_TUNNEL_TT, /* L4 */
+			BIT(1),
+			BIT(0),
+		},
+	},
+	[TTC_GROUPS_USE_L4_TYPE_GTPU] = {
+		.gtpu_group = true,
+		.use_l4_type = true,
+		.num_groups = 5,
+		.group_size = {
+			MLX5_TTC_GTPU_GROUP_SIZE,                                   /* GTP-U */
+			MLX5_TTC_GROUP_TCPUDP_SIZE,                                 /* TCP/UDP */
+			BIT(3) + MLX5_NUM_TUNNEL_TT - MLX5_TTC_GROUP_TCPUDP_SIZE,  /* L4 */
+			BIT(1),
+			BIT(0),
+		},
+	},
+	[TTC_GROUPS_DEFAULT_ESP_GTPU] = {
+		.gtpu_group = true,
+		.num_groups = 7,
+		.group_size = {
+			MLX5_TTC_GTPU_GROUP_SIZE,                              /* GTP-U */
+			MLX5_TTC_GROUP_TCPUDP_SIZE + BIT(1) + MLX5_NUM_TUNNEL_TT, /* L4 */
+			BIT(2), /* decrypted outer L4 */
+			BIT(2), /* decrypted inner L4 */
+			BIT(1), /* ESP */
+			BIT(1),
+			BIT(0),
+		},
+	},
+	[TTC_GROUPS_USE_L4_TYPE_ESP_GTPU] = {
+		.gtpu_group = true,
+		.use_l4_type = true,
+		.num_groups = 8,
+		.group_size = {
+			MLX5_TTC_GTPU_GROUP_SIZE,    /* GTP-U */
+			MLX5_TTC_GROUP_TCPUDP_SIZE,  /* TCP/UDP */
+			BIT(1) + MLX5_NUM_TUNNEL_TT, /* L4 */
+			BIT(2), /* decrypted outer L4 */
+			BIT(2), /* decrypted inner L4 */
+			BIT(1), /* ESP */
+			BIT(1),
+			BIT(0),
+		},
+	},
 };
 
 static const struct mlx5_fs_ttc_groups inner_ttc_groups[] = {
@@ -239,8 +307,18 @@ static const struct mlx5_fs_ttc_groups inner_ttc_groups[] = {
 };
 
 static const struct mlx5_fs_ttc_groups *
-mlx5_ttc_get_fs_groups(bool use_l4_type, bool ipsec_rss)
+mlx5_ttc_get_fs_groups(bool use_l4_type, bool ipsec_rss, bool gtpu_rss)
 {
+	if (gtpu_rss) {
+		if (!ipsec_rss)
+			return use_l4_type ?
+				&ttc_groups[TTC_GROUPS_USE_L4_TYPE_GTPU] :
+				&ttc_groups[TTC_GROUPS_GTPU];
+		return use_l4_type ?
+			&ttc_groups[TTC_GROUPS_USE_L4_TYPE_ESP_GTPU] :
+			&ttc_groups[TTC_GROUPS_DEFAULT_ESP_GTPU];
+	}
+
 	if (!ipsec_rss)
 		return use_l4_type ? &ttc_groups[TTC_GROUPS_USE_L4_TYPE] :
 				     &ttc_groups[TTC_GROUPS_DEFAULT];
@@ -252,7 +330,9 @@ mlx5_ttc_get_fs_groups(bool use_l4_type, bool ipsec_rss)
 bool mlx5_ttc_has_esp_flow_group(struct mlx5_ttc_table *ttc)
 {
 	return ttc->groups == &ttc_groups[TTC_GROUPS_DEFAULT_ESP] ||
-	       ttc->groups == &ttc_groups[TTC_GROUPS_USE_L4_TYPE_ESP];
+	       ttc->groups == &ttc_groups[TTC_GROUPS_USE_L4_TYPE_ESP] ||
+	       ttc->groups == &ttc_groups[TTC_GROUPS_DEFAULT_ESP_GTPU] ||
+	       ttc->groups == &ttc_groups[TTC_GROUPS_USE_L4_TYPE_ESP_GTPU];
 }
 
 u8 mlx5_get_proto_by_tunnel_type(enum mlx5_tunnel_types tt)
@@ -395,6 +475,42 @@ mlx5_generate_ttc_rule(struct mlx5_core_dev *dev, struct mlx5_flow_table *ft,
 	return err ? ERR_PTR(err) : rule;
 }
 
+static struct mlx5_flow_handle *
+mlx5_generate_gtpu_ttc_rule(struct mlx5_core_dev *dev,
+			    struct mlx5_flow_table *ft,
+			    struct mlx5_flow_destination *dest,
+			    u16 etype)
+{
+	MLX5_DECLARE_FLOW_ACT(flow_act);
+	struct mlx5_flow_handle *rule;
+	struct mlx5_flow_spec *spec;
+	int err = 0;
+
+	spec = kvzalloc(sizeof(*spec), GFP_KERNEL);
+	if (!spec)
+		return ERR_PTR(-ENOMEM);
+
+	spec->match_criteria_enable = MLX5_MATCH_OUTER_HEADERS;
+	mlx5_fs_ttc_set_match_ipv_outer(dev, spec, etype);
+	MLX5_SET_TO_ONES(fte_match_param, spec->match_criteria,
+			 outer_headers.ip_protocol);
+	MLX5_SET(fte_match_param, spec->match_value,
+		 outer_headers.ip_protocol, IPPROTO_UDP);
+	MLX5_SET_TO_ONES(fte_match_param, spec->match_criteria,
+			 outer_headers.udp_dport);
+	MLX5_SET(fte_match_param, spec->match_value,
+		 outer_headers.udp_dport, GTP1U_PORT);
+
+	rule = mlx5_add_flow_rules(ft, spec, &flow_act, dest, 1);
+	if (IS_ERR(rule)) {
+		err = PTR_ERR(rule);
+		mlx5_core_err(dev, "%s: add GTP-U TTC rule failed\n", __func__);
+	}
+
+	kvfree(spec);
+	return err ? ERR_PTR(err) : rule;
+}
+
 static int mlx5_generate_ttc_table_rules(struct mlx5_core_dev *dev,
 					 struct ttc_params *params,
 					 struct mlx5_ttc_table *ttc,
@@ -416,11 +532,20 @@ static int mlx5_generate_ttc_table_rules(struct mlx5_core_dev *dev,
 
 		if (test_bit(tt, params->ignore_dests))
 			continue;
-		rule->rule = mlx5_generate_ttc_rule(dev, ft, &params->dests[tt],
-						    ttc_rules[tt].etype,
-						    ttc_rules[tt].proto,
-						    use_l4_type,
-						    params->ipsec_rss);
+
+		if (mlx5_ttc_is_gtpu_tt(tt)) {
+			if (!params->gtpu_rss)
+				continue;
+			rule->rule = mlx5_generate_gtpu_ttc_rule(dev, ft,
+								 &params->dests[tt],
+								 ttc_rules[tt].etype);
+		} else {
+			rule->rule = mlx5_generate_ttc_rule(dev, ft, &params->dests[tt],
+							    ttc_rules[tt].etype,
+							    ttc_rules[tt].proto,
+							    use_l4_type,
+							    params->ipsec_rss);
+		}
 		if (IS_ERR(rule->rule)) {
 			err = PTR_ERR(rule->rule);
 			rule->rule = NULL;
@@ -553,6 +678,21 @@ static int mlx5_create_ttc_table_groups(struct mlx5_ttc_table *ttc,
 		MLX5_SET_TO_ONES(fte_match_param, mc, outer_headers.ethertype);
 	MLX5_SET_CFG(in, match_criteria_enable, MLX5_MATCH_OUTER_HEADERS);
 
+	/* GTP-U group: matches on ethertype + ip_protocol + udp_dport */
+	if (groups->gtpu_group) {
+		MLX5_SET_TO_ONES(fte_match_param, mc, outer_headers.ip_protocol);
+		MLX5_SET_TO_ONES(fte_match_param, mc, outer_headers.udp_dport);
+		MLX5_SET_CFG(in, start_flow_index, ix);
+		ix += groups->group_size[ttc->num_groups];
+		MLX5_SET_CFG(in, end_flow_index, ix - 1);
+		ttc->g[ttc->num_groups] = mlx5_create_flow_group(ttc->t, in);
+		if (IS_ERR(ttc->g[ttc->num_groups]))
+			goto err;
+		ttc->num_groups++;
+		MLX5_SET(fte_match_param, mc, outer_headers.ip_protocol, 0);
+		MLX5_SET(fte_match_param, mc, outer_headers.udp_dport, 0);
+	}
+
 	/* TCP UDP group */
 	if (groups->use_l4_type) {
 		MLX5_SET_TO_ONES(fte_match_param, mc, outer_headers.l4_type);
@@ -892,7 +1032,8 @@ struct mlx5_ttc_table *mlx5_create_ttc_table(struct mlx5_core_dev *dev,
 		return ERR_PTR(-EOPNOTSUPP);
 	}
 
-	ttc->groups = mlx5_ttc_get_fs_groups(use_l4_type, params->ipsec_rss);
+	ttc->groups = mlx5_ttc_get_fs_groups(use_l4_type, params->ipsec_rss,
+					      params->gtpu_rss);
 
 	WARN_ON_ONCE(params->ft_attr.max_fte);
 	params->ft_attr.max_fte = mlx5_fs_ttc_table_size(ttc->groups);
diff --git a/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.h b/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.h
index 95f6e56724a2..cd31a642f926 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.h
+++ b/drivers/net/ethernet/mellanox/mlx5/core/lib/fs_ttc.h
@@ -15,6 +15,8 @@ enum mlx5_traffic_types {
 	MLX5_TT_IPV6_IPSEC_AH,
 	MLX5_TT_IPV4_IPSEC_ESP,
 	MLX5_TT_IPV6_IPSEC_ESP,
+	MLX5_TT_IPV4_GTPU,
+	MLX5_TT_IPV6_GTPU,
 	MLX5_TT_IPV4,
 	MLX5_TT_IPV6,
 	MLX5_TT_ANY,
@@ -56,6 +58,7 @@ struct ttc_params {
 	DECLARE_BITMAP(ignore_tunnel_dests, MLX5_NUM_TUNNEL_TT);
 	struct mlx5_flow_destination tunnel_dests[MLX5_NUM_TUNNEL_TT];
 	bool ipsec_rss;
+	bool gtpu_rss;
 };
 
 const char *mlx5_ttc_get_name(enum mlx5_traffic_types tt);
@@ -89,4 +92,9 @@ static inline bool mlx5_ttc_is_decrypted_esp_tt(enum mlx5_traffic_types tt)
 	       tt <= MLX5_TT_DECRYPTED_ESP_INNER_IPV6_UDP;
 }
 
+static inline bool mlx5_ttc_is_gtpu_tt(enum mlx5_traffic_types tt)
+{
+	return tt == MLX5_TT_IPV4_GTPU || tt == MLX5_TT_IPV6_GTPU;
+}
+
 #endif /* __MLX5_FS_TTC_H__ */
diff --git a/include/linux/mlx5/device.h b/include/linux/mlx5/device.h
index b37fe39cef27..c886967732e0 100644
--- a/include/linux/mlx5/device.h
